rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function housePath(hid) { return /databases/$(database)/documents/households/$(hid); }
    function isMember(hid) { return signedIn() && request.auth.uid in get(housePath(hid)).data.access; }
    function isOwner(hid) { return signedIn() && get(housePath(hid)).data.ownerUid == request.auth.uid; }
    function isMemberAfter(hid) { return signedIn() && request.auth.uid in getAfter(housePath(hid)).data.access; }
    function invitationPath(token) { return /databases/$(database)/documents/invitations/$(token); }
    function linkPath(hid, mid) { return /databases/$(database)/documents/households/$(hid)/accountLinks/$(mid); }
    function ownsLinkAfter(hid, mid) { return getAfter(linkPath(hid, mid)).data.uid == request.auth.uid; }
    function canJoin(hid) {
      let entry = request.resource.data.access[request.auth.uid];
      let invitation = get(invitationPath(entry.invitationId)).data;
      return !(request.auth.uid in resource.data.access)
        && request.auth.token.email_verified == true
        && invitation.email == request.auth.token.email.lower()
        && invitation.householdId == hid
        && invitation.memberId == entry.memberId
        && !('usedBy' in invitation)
        && invitation.expiresAt > request.time
        && getAfter(invitationPath(entry.invitationId)).data.usedBy == request.auth.uid
        && ownsLinkAfter(hid, entry.memberId)
        && entry.memberId != resource.data.access[resource.data.ownerUid].memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access'])
        && request.resource.data.access.diff(resource.data.access).affectedKeys().hasOnly([request.auth.uid])
        && entry.keys().hasOnly(['memberId', 'invitationId']);
    }
    match /identities/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['favoriteHouseholdId'])
        && isMember(request.resource.data.favoriteHouseholdId);
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['householdId', 'memberId', 'favoriteHouseholdId'])
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteHouseholdId']))
        && isMember(request.resource.data.favoriteHouseholdId);
      allow delete: if false;
      match /memberships/{hid} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['householdId', 'memberId'])
          && request.resource.data.householdId == hid
          && isMemberAfter(hid)
          && getAfter(housePath(hid)).data.access[uid].memberId == request.resource.data.memberId;
        allow update, delete: if false;
      }
    }
    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'name', 'ownerUid', 'access'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision == 0
        && request.resource.data.access.keys().hasOnly([request.auth.uid])
        && request.resource.data.access[request.auth.uid].keys().hasOnly(['memberId'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && ownsLinkAfter(hid, request.resource.data.access[request.auth.uid].memberId);
      allow update: if signedIn() && (
        (isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision'])
          && request.resource.data.revision == resource.data.revision + 1)
        || canJoin(hid)
      );
      allow delete: if false;
      match /accountLinks/{mid} {
        allow get: if isMember(hid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'memberId'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.memberId == mid
          && isMemberAfter(hid)
          && getAfter(housePath(hid)).data.access[request.auth.uid].memberId == mid;
        allow list, update, delete: if false;
      }
      match /{collection}/{id} {
        allow read: if isMember(hid) && collection in ['members', 'groups', 'tasks', 'sessions', 'overrides'];
        allow create, update: if isMemberAfter(hid)
          && collection in ['members', 'groups', 'tasks', 'sessions', 'overrides']
          && request.resource.data.id == id
          && (collection != 'members' || isOwner(hid)
            || (getAfter(housePath(hid)).data.ownerUid == request.auth.uid)
            || (resource != null && get(housePath(hid)).data.access[request.auth.uid].memberId == id
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])));
        allow delete: if isMember(hid) && collection in ['groups', 'tasks', 'sessions', 'overrides'];
      }
    }
    match /invitations/{token} {
      allow get: if signedIn() && (isOwner(resource.data.householdId)
        || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email.lower()));
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'memberId', 'email', 'createdBy', 'createdAt', 'expiresAt'])
        && isOwner(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && !exists(linkPath(request.resource.data.householdId, request.resource.data.memberId))
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId)/members/$(request.resource.data.memberId));
      allow update: if signedIn()
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email.lower()
        && !('usedBy' in resource.data) && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && isMemberAfter(resource.data.householdId)
        && getAfter(housePath(resource.data.householdId)).data.access[request.auth.uid].invitationId == token;
      allow delete: if isOwner(resource.data.householdId);
    }
  }
}
